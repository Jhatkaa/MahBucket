<p>
  <strong>Filename:</strong>
  <%= @item.file_file_name %>
</p>
<p>
  <% if @item.image? %>
  <%= image_tag @item.file.url( :display, false ) %>
  <% else %>
  <%= image_tag "/themes/#{theme}/images/default-file-icon.png" %>
  <% end %>
</p>
<p>
  Tags: <% @item.tags.each do |tag| %>
    <%= link_to( tag.name, tag ) %><%= ', ' unless tag == @item.tags.last %>
    <% end %>
</p>

<% if @item.image? %>
  <% @item.file.styles.each do |style,style_obj| %>
  <p>
    <%= style.capitalize %> (<%= @item.file.width(style) %>x<%= @item.file.height(style) %>):
    <input type="text" size="100" value="<%= @item.file.url( style, false ) %>" id="<%= @item.id %>-<%=style %>">
    <button type="button" onclick='copyToClipboard("<%= @item.id %>-<%= style %>")'>Copy</button>
    </p>
  <% end %>
<% end %>
<p>
  <% if @item.image? %>Original (<%= @item.file.width %>x<%= @item.file.height %>):<% else %>Link:<% end %>
  <input type="text" size="100" value="<%= @item.file.url( 'original', false ) %>" id="<%= @item.id %>-original">
  <button type="button" onclick='copyToClipboard("<%= @item.id %>-original")'>Copy</button>
</p>

<%= link_to 'Edit', edit_item_path(@item) %> |
<%= link_to 'Back', items_path %>

<script>
  function copyToClipboard(elementId) {
    var copyText = document.getElementById(elementId);
    copyText.select();
    copyText.setSelectionRange(0, 99999); // For mobile devices
    document.execCommand("copy");
  }
</script>